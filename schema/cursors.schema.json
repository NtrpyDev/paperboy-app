{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cursors",
  "description": "state/cursors.json. For each source, the last day (UTC) it has been processed through: discovered, judged, and published. Discover starts the day after. Only the cursors command writes it, and only forward.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "cursors"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "cursors": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "arxiv",
          "biorxiv",
          "medrxiv",
          "europepmc",
          "crossref"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}
