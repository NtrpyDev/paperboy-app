{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeedItem",
  "description": "One paper as the app receives it inside a chunk.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "hook",
    "summary",
    "field",
    "tags",
    "status",
    "venue",
    "published",
    "authors_short",
    "url",
    "has_explainer",
    "significance",
    "added_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(arxiv|doi)-[a-z0-9._-]+$",
      "description": "Stable paper id: arxiv-<id> or doi-<doi with every character outside a-z 0-9 . _ - replaced by ->, lowercase."
    },
    "title": {
      "type": "string"
    },
    "hook": {
      "type": "string",
      "minLength": 8,
      "maxLength": 110,
      "description": "One-line plain-language headline. Not the paper's title."
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 520,
      "description": "Two to four plain sentences in original words."
    },
    "field": {
      "enum": [
        "physics",
        "space",
        "math",
        "cs",
        "biology",
        "neuroscience",
        "medicine",
        "chemistry",
        "earth",
        "engineering",
        "social"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 32
      }
    },
    "status": {
      "enum": [
        "preprint",
        "peer_reviewed"
      ]
    },
    "venue": {
      "type": "string"
    },
    "published": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authors_short": {
      "type": "string",
      "description": "For example: Abbott et al."
    },
    "url": {
      "type": "string"
    },
    "has_explainer": {
      "type": "boolean"
    },
    "explainer": {
      "type": "string",
      "description": "Path from the content base, for example papers/<id>/. Present when has_explainer is true."
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path from the content base, for example papers/<id>/hero.webp"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "significance": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "added_at": {
      "type": "string",
      "description": "UTC time the item entered the feed, RFC 3339."
    }
  }
}
