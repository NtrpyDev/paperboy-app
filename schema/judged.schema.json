{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judged",
  "description": "A candidate after the scout has judged it (one JSON object per line in work/judged.jsonl). select writes these; queue add puts them in the backlog; publish reads the ones that have a page.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "authors",
    "abstract",
    "venue",
    "published",
    "status",
    "url",
    "source",
    "fulltext",
    "hook",
    "summary",
    "field",
    "tags",
    "significance",
    "explain"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(arxiv|doi)-[a-z0-9._-]+$",
      "description": "Stable paper id: arxiv-<id> or doi-<doi with every character outside a-z 0-9 . _ - replaced by ->, lowercase."
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "arxiv_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abstract": {
      "type": "string",
      "description": "Pipeline input only. Never published."
    },
    "venue": {
      "type": "string",
      "description": "Journal name, or the preprint server's name."
    },
    "published": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "preprint",
        "peer_reviewed"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ],
      "description": "Lowercase license id when the source states one: cc0, cc-by, cc-by-sa, cc-by-nc, cc-by-nd, cc-by-nc-sa, cc-by-nc-nd, arxiv-nonexclusive, other."
    },
    "url": {
      "type": "string",
      "description": "The paper's landing page."
    },
    "source": {
      "enum": [
        "arxiv",
        "biorxiv",
        "medrxiv",
        "europepmc",
        "crossref"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The source's own subject labels."
    },
    "fulltext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "arxiv_html",
            "biorxiv",
            "europepmc",
            null
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "hook": {
      "type": "string",
      "minLength": 8,
      "maxLength": 110,
      "description": "One-line plain-language headline. Not the paper's title."
    },
    "hook_turn": {
      "$ref": "feed-item.schema.json#/properties/hook_turn"
    },
    "readout": {
      "$ref": "feed-item.schema.json#/properties/readout"
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 520,
      "description": "Two to four plain sentences in original words."
    },
    "field": {
      "enum": [
        "physics",
        "space",
        "math",
        "cs",
        "biology",
        "neuroscience",
        "medicine",
        "chemistry",
        "earth",
        "engineering",
        "social"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 32
      }
    },
    "significance": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "explain": {
      "type": "boolean",
      "description": "Whether the paper may get a full explainer: full text of a kind listed in pipeline/config.json and significance at least the explain floor. select sets it and queue add sets it again from its own floor and kinds; queue back turns it false when a full explainer failed. A paper with false here can get only a quick explainer."
    }
  }
}
